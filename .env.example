# === LLM Configuration ===
# Choose which provider to use: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# === Embedding Model ===
# Used for RAG vector search (always OpenAI for simplicity)
EMBEDDING_MODEL=text-embedding-3-small

# === Database (SQL Server) ===
# Requer um ODBC Driver for SQL Server instalado (ex: "ODBC Driver 17 for SQL Server")
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=intelbras_db
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=your-strong-password
# Encrypt=yes/no e TrustServerCertificate=yes/no (útil para ambientes locais/dev)
SQLSERVER_ENCRYPT=no
SQLSERVER_TRUST_CERT=yes

# === Knowledge Base ===
OKF_KNOWLEDGE_PATH=./knowledge
CHROMA_PERSIST_PATH=./data/chroma_db
